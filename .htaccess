Options -Indexes

RewriteEngine On
RewriteBase /

# Durable local fallbacks and the hosted virtual environment are never public assets.
RewriteRule ^(?:data|docs|\.venv_linux)(?:/|$) - [F,L,NC]

# Reject direct requests for server-side source/configuration, operational output and internal data. Flask may
# still read these files after an /api/* rewrite; THE_REQUEST limits the rule to a browser asking for the file.
RewriteCond %{THE_REQUEST} "\s/+[^?\s]*\.(?:py|sql|md|txt|key|env|json|log|zip|docx|pkl)(?:[?\s])" [NC]
RewriteRule ^ - [F,L]

# The adapter is an internal rewrite target, not a second public API prefix.
RewriteCond %{THE_REQUEST} "\s/+cgi-bin/" [NC]
RewriteRule ^cgi-bin/ - [F,L]

# Static HTML is served by Apache; only API traffic enters the Flask CGI application.
RewriteRule ^api(?:/(.*))?$ cgi-bin/app.py/api/$1 [L,QSA]
