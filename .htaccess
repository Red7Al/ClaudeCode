Options -Indexes

# Security headers apply at Apache's static-file layer as well as to the Flask CGI responses. CSP is
# report-only for now: index.html deliberately contains inline script and style, so enforcement needs a
# later nonce/hash pass rather than risking a blank production page.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
</IfModule>

# app.js was extracted from index.html on 2026-08-23. The two must never disagree, so the script is
# revalidated on every request: a browser holding yesterday's JavaScript against today's markup is a
# silent failure with nothing on screen to explain it.
<IfModule mod_headers.c>
  <Files "app.js">
    Header always set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

RewriteEngine On
RewriteBase /

# Durable local fallbacks and the hosted virtual environment are never public assets.
RewriteRule ^(?:data|docs|\.venv_linux)(?:/|$) - [F,L,NC]

# Reject direct requests for server-side source/configuration, operational output and internal data. Flask may
# still read these files after an /api/* rewrite; THE_REQUEST limits the rule to a browser asking for the file.
RewriteCond %{THE_REQUEST} "\s/+[^?\s]*\.(?:py|sql|md|txt|key|env|json|log|zip|docx|pkl)(?:[?\s])" [NC]
RewriteRule ^ - [F,L]

# The adapter is an internal rewrite target, not a second public API prefix.
RewriteCond %{THE_REQUEST} "\s/+cgi-bin/" [NC]
RewriteRule ^cgi-bin/ - [F,L]

# Static HTML is served by Apache; only API traffic enters the Flask CGI application.
RewriteRule ^api(?:/(.*))?$ cgi-bin/app.py/api/$1 [L,QSA]
