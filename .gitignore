# Frozen HVF regression fixtures MUST be committed (test_hvf_method.py, CI gate)
!tests_fixtures/*.csv

# Local Slack creds for the dossier launcher — NEVER track (user 2026-06-16; secrets stay out
# of the repo, see memory secrets_and_x_delivery). instrument_dossier.CMD is tracked but holds
# NO secrets — it CALLs this file, which each operator creates locally.
launcher_secrets.cmd

# local run logs
hvf_web/run.log

# Local assistant scratch file; never source or deployable content.
a.tmp

# Personal ToDo / change-request notes to Claude — local working notes, not tracked
ChangeRequests/
tests_fixtures/performance-best-settings.png

# Production packages are reproducible build outputs, never source.
dist/

# The IONOS site serves these in-app HTML guides; keep their source/builder and deployable HTML reproducible.
# DOCX guide exports remain ignored by the global *.docx rule.
!docs/_build_guides.js
!docs/_guides_content.js
!docs/guides/
!docs/guides/*.html
!docs/guides/_manifest.json

# Test fixtures are frozen INPUT DATA, not runtime state - the golden-number replay tests are
# worthless without them. Market data only (tickers, dates, prices, returns); no credentials.
!tests_fixtures/*.json
